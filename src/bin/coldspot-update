#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 asuramaya and coldspot contributors
"""coldspot-update — check GitHub for newer releases and install them.

Thin wrapper over the vendored sutra_update.py (UNIFY.md Wave A #1, the
family's shared update spine: one grammar, one trust chain -- SHA256
manifest hash-checked always, ssh-keygen -Y verify of the manifest's
signature against the pinned anchor mandatory once armed (coldspot has
been armed since v0.5.0, so this fails closed on any missing/failed
check) -- one install-path detection, shared fleet-wide instead of a
hand-rolled copy). This file supplies only what's coldspot-specific: the
repo slug, the installed-version lookup (dpkg first for a future .deb
install, VERSION file fallback for today's source install), where the
signing anchor lives, and reading /etc/coldspot.conf's auto_update= toggle
(coldspot, unlike some siblings, actually supports opt-in unattended
installs via the daily timer).

  coldspot-update            install if a newer release exists (manual;
                              this is what `coldspot update` runs)
  coldspot-update --auto     timer tier; no-ops unless auto_update=on in
                              /etc/coldspot.conf, and further refuses
                              unless the signing anchor is armed
  coldspot-update --check    notify tier: report only, don't install
  coldspot-update --json     machine-readable {current,latest,available,armed}
Intended to run from coldspot-update.timer (daily) as root.
"""
import os
import subprocess
import sys

# --- sutra bootstrap (sutra 0.8.0; see BOOTSTRAP.md -- do not hand-edit) ----
import os as _os
import sys as _sys
_PILL = "coldspot"
_libdir = _os.path.join(
    _os.path.dirname(_os.path.dirname(_os.path.realpath(__file__))),
    "share", _PILL, "lib")
if _libdir not in _sys.path:
    _sys.path.insert(0, _libdir)
del _os, _sys, _libdir, _PILL
# --- end sutra bootstrap ----------------------------------------------------
import sutra_update  # noqa: E402

REPO_SLUG = "asuramaya/coldspot"
PILL = "coldspot"
CONF = "/etc/coldspot.conf"
# This file lives at src/bin/coldspot-update -- one level under $PREFIX/bin
# once installed, but TWO under the repo root in a checkout (bin/ sits
# under src/, which is the checkout's own analog of $PREFIX; see
# docs/ARCHITECTURE.md's Conventions). HERE is one dirname; the checkout
# candidates below add the second explicitly, same fix as the sutra vendor
# path (Alfred, msg 1736) and cmd_version()/_read_daemon_version().
HERE = os.path.dirname(os.path.realpath(__file__))
VERSION_CANDIDATES = (
    "/usr/local/share/coldspot/VERSION",
    "/usr/share/coldspot/VERSION",
    os.path.join(HERE, "..", "..", "packaging", "VERSION"),
)
ANCHOR_CANDIDATES = (
    "/usr/local/share/coldspot/allowed_signers",
    "/usr/share/coldspot/allowed_signers",
    os.path.join(HERE, "..", "..", "packaging", "release-signing", "allowed_signers"),
)


def deb_version():
    """The dpkg-registered package version, or None if not a .deb install
    (coldspot has no .deb yet -- Pass 5 -- so this is always None today;
    kept so Pass 5 doesn't need to touch this file again)."""
    try:
        out = subprocess.check_output(
            ["dpkg-query", "-W", "-f=${Version}", PILL],
            stderr=subprocess.DEVNULL)
        return out.decode().strip() or None
    except Exception:
        return None


def installed_version():
    """Best-effort version for display/--check: dpkg first (authoritative
    across a .deb upgrade), else whichever VERSION file a source install or
    dev checkout wrote. Never fails outright -- an unreadable version is a
    display/comparison problem, not a reason to refuse to check at all."""
    v = deb_version()
    if v:
        return v
    for path in VERSION_CANDIDATES:
        try:
            with open(path) as f:
                v = f.read().strip()
        except OSError:
            continue
        if v:
            return v
    return "unknown"


def auto_update_enabled():
    """True only when /etc/coldspot.conf sets auto_update to a truthy
    value. Absent key, missing file, or any other value keeps auto-update
    OFF (secure default). A later line wins over an earlier one, same as
    the original bash implementation's `tail -n1`."""
    v = None
    try:
        with open(CONF) as f:
            for line in f:
                line = line.split("#", 1)[0].strip()
                key, sep, val = line.partition("=")
                if sep and key.strip() == "auto_update":
                    v = val.strip()
    except OSError:
        return False
    return (v or "").lower() in ("on", "true", "yes", "1")


if __name__ == "__main__":
    sys.exit(sutra_update.main(
        pill=PILL, slug=REPO_SLUG, installed_version=installed_version(),
        anchor_candidates=list(ANCHOR_CANDIDATES),
        auto_enabled=auto_update_enabled()))
