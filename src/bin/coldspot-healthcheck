#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 asuramaya and coldspot contributors
"""coldspot-healthcheck — are the daemon's vitals good?

Thin wrapper over sutra.check_health (UNIFY Wave A #3): status.json fresh
against the daemon's own declared poll_interval, control.sock answering
ping. Exit 0 when healthy, nonzero with a one-line reason when not.

Also verifies the INSTALLED sutra modules against their own INSTALLED
anchors (BOOTSTRAP.md): `make check-sutra` only ever proves the dev-tree
copy under src/share/coldspot/lib/ wasn't hand-edited, never what this
machine is actually running. A mismatch here means the installed copy and
its own installed .version anchor disagree -- the exact blind spot that
let two pills run different sutra commits on one machine with nothing
able to notice (ruling 3e44bd95). Checks all three vendored modules
(sutra, sutra_update, sutra_xen), not just sutra.py -- phanspeed's more
thorough form, taken as the reference for this part; the libdir itself is
derived from sutra.__file__ (the module actually imported), ramstein's
form, rather than a hardcoded guess.

Three states per module, not two: a missing anchor means an install that
predates this check (or the private-lib-dir move), not a tampered one --
it can't be verified, which is different from having been checked and
found wrong. Collapsing that third state into a failure was a real bug
elsewhere in the family (phanspeed, maat's finding e0aaa447).

Passive by design: it diagnoses and reports, it never restarts anything —
coldspotd.service already has Restart=on-failure, and a monitoring probe
that mutates what it measures can't be trusted.
"""

import hashlib
import os
import sys

# --- sutra bootstrap (sutra 0.12.1; see BOOTSTRAP.md -- do not hand-edit) ----
import os as _os
import sys as _sys
_PILL = "coldspot"
_libdir = _os.path.join(
    _os.path.dirname(_os.path.dirname(_os.path.realpath(__file__))),
    "share", _PILL, "lib")
if _libdir not in _sys.path:
    _sys.path.insert(0, _libdir)
del _os, _sys, _libdir, _PILL
# --- end sutra bootstrap ----------------------------------------------------
import sutra  # noqa: E402

RUNTIME_DIR = "/run/coldspot"
STATUS_PATH = os.path.join(RUNTIME_DIR, "status.json")
SOCKET_PATH = os.path.join(RUNTIME_DIR, "control.sock")


def _module_sutra_ok(mod, libdir):
    """None when the anchor is missing (older install, can't verify);
    otherwise True/False for whether the installed <mod>.py's own sha256
    still matches the .version anchor installed beside it."""
    py = os.path.join(libdir, f"{mod}.py")
    vf = os.path.join(libdir, f"{mod}.version")
    try:
        with open(vf) as f:
            recorded = f.read().split()[-1]
    except (OSError, IndexError):
        return None
    with open(py, "rb") as f:
        actual = hashlib.sha256(f.read()).hexdigest()
    return recorded == actual


def verify_installed_sutra():
    """(ok, notes) -- ok is False only on an actual mismatch, never on a
    missing anchor."""
    libdir = os.path.dirname(os.path.abspath(sutra.__file__))
    ok = True
    notes = []
    for mod in ("sutra", "sutra_update", "sutra_xen"):
        state = _module_sutra_ok(mod, libdir)
        if state is None:
            notes.append(f"{mod} anchor missing (older install, can't verify)")
        elif state is False:
            notes.append(f"{mod}.py does not match its installed anchor "
                         "(hand-edited, corrupted, or two pills' installers collided)")
            ok = False
        else:
            notes.append(f"{mod} ok")
    return ok, "; ".join(notes)


def main():
    sutra_ok, sutra_notes = verify_installed_sutra()
    if not sutra_ok:
        print(f"unhealthy: {sutra_notes}")
        return 1

    healthy, reason, info = sutra.check_health(STATUS_PATH, SOCKET_PATH)
    if not healthy:
        print(f"unhealthy: {reason}")
        return 1

    print(f"healthy: status {info['age']:.0f}s old (limit {info['limit']:.0f}s), "
          f"socket ping ok, daemon v{info['version']} ({sutra_notes})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
