[Unit]
Description=coldspot auto-update (check GitHub releases, install newer in place)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Short-lived oneshot; the only coldspot component that reaches the internet.
# --auto makes the updater a no-op unless auto_update=on in /etc/coldspot.conf.
# So this actually installs only if the user enabled auto_update AND enabled the
# timer (both are opt-in); otherwise it just prints a hint and exits 0.
ExecStart=/usr/local/bin/coldspot-update --auto
